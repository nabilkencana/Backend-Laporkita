// =============================================================
// src/prisma/schema.prisma
// Single source of truth untuk skema database LaporKita.
// Semua entitas mengacu pada ERD.md.
//
// PENTING: Tabel `zones` menggunakan PostGIS geometry.
// Jalankan terlebih dahulu di PostgreSQL:
//   CREATE EXTENSION IF NOT EXISTS postgis;
// =============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  // URL dikonfigurasi di prisma.config.ts (Prisma 7 requirement)
  // DATABASE_URL dibaca dari environment variable via prisma.config.ts
}

// ═══════════════════════════════════════════════════════════
// ENUMS — persis sesuai ERD.md
// ═══════════════════════════════════════════════════════════

/// Role pengguna dalam sistem (ERD §2.1)
enum UserRole {
  citizen
  operator
  policy_maker
  admin
}

/// Tipe instansi pemerintah (ERD §2.2)
enum AgencyType {
  dpupr
  dishub
  diskominfo
  lainnya
}

/// Status laporan — state machine persis sesuai Rules.md §1.1
/// Urutan valid: pending_verification → verified|rejected
///               verified → assigned → in_progress → completed
///               completed → resolved|disputed
///               disputed → in_progress (kembali)
///               rejected = final
enum ReportStatus {
  pending_verification
  verified
  rejected
  assigned
  in_progress
  completed
  resolved
  disputed
}

/// Tipe media yang diunggah ke laporan (ERD §2.5)
enum MediaType {
  initial_photo
  progress_photo
  completion_photo
}

/// Tipe notifikasi yang dikirim ke user (ERD §2.15)
enum NotificationType {
  route_alert
  status_update
  support_received
  system
}

/// Tingkat stres zona untuk Urban Emotion Map (ERD §2.11)
enum StressLevel {
  low
  medium
  high
}

/// Alasan pemberian poin kontribusi (ERD §2.10)
enum ContributionReason {
  report_submitted
  report_verified
  validation_given
  support_given
}

// ═══════════════════════════════════════════════════════════
// MODELS
// ═══════════════════════════════════════════════════════════

/// Pengguna sistem — warga, operator, policy_maker, admin (ERD §2.1)
model User {
  id                  String   @id @default(uuid()) @db.Uuid
  full_name           String   @db.VarChar(255)
  /// Wajib salah satu: email ATAU phone_number (Rules.md §2.2)
  email               String?  @unique @db.VarChar(255)
  phone_number        String?  @unique @db.VarChar(20)
  /// Nullable jika login via OTP/OAuth
  password_hash       String?  @db.VarChar(255)
  role                UserRole @default(citizen)
  /// Hanya diisi untuk role operator/policy_maker
  agency_id           String?  @db.Uuid
  /// Denormalized dari contribution_points_log untuk performa baca cepat (ERD §5)
  contribution_points   Int      @default(0)
  /// Flag review admin jika user terindikasi spam (>3x reject dlm 30 hari - Rules.md §1.6)
  is_flagged_for_review Boolean  @default(false)
  avatar_url            String?  @db.VarChar(500)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  // Relations
  agency             Agency?                  @relation("UserAgency", fields: [agency_id], references: [id])
  reports            Report[]                 @relation("ReporterReports")
  assigned_reports   Report[]                 @relation("AssignedOfficerReports")
  status_changes     ReportStatusHistory[]
  supports           ReportSupport[]
  comments           ReportComment[]
  validations        CitizenValidation[]
  media_uploads      ReportMedia[]
  points_log         ContributionPointsLog[]
  notifications      Notification[]
  policy_simulations PolicySimulation[]
  route_alert_sub    RouteAlertSubscription?

  @@map("users")
}

/// Instansi pemerintah terkait (DPUPR, Dishub, Diskominfo) (ERD §2.2)
model Agency {
  id            String     @id @default(uuid()) @db.Uuid
  name          String     @db.VarChar(255)
  type          AgencyType
  contact_email String     @db.VarChar(255)
  created_at    DateTime   @default(now())

  // Relations
  users            User[]     @relation("UserAgency")
  categories       Category[]
  assigned_reports Report[]   @relation("AssignedAgencyReports")

  @@map("agencies")
}

/// Kategori fasilitas umum (ERD §2.3)
/// 5 kategori aktif MVP: Jalan Berlubang, Lampu Jalan, Rambu Lalu Lintas, Trotoar, Drainase
model Category {
  id                String  @id @default(uuid()) @db.Uuid
  name              String  @db.VarChar(100)
  icon_url          String? @db.VarChar(500)
  /// Instansi default untuk routing otomatis laporan (Rules.md §1.7)
  default_agency_id String? @db.Uuid
  /// Bobot untuk Smart Priority Engine (Rules.md §1.3 — w4_category_urgency_weight)
  urgency_weight    Float   @default(1.0)

  // Relations
  default_agency Agency?  @relation(fields: [default_agency_id], references: [id])
  reports        Report[]

  @@map("categories")
}

/// Laporan fasilitas umum — entitas utama sistem (ERD §2.4)
model Report {
  id                      String       @id @default(uuid()) @db.Uuid
  /// Format: #LP-2026-002487 — di-generate di service layer
  report_code             String       @unique @db.VarChar(20)
  /// Idempotency key dari client untuk mencegah duplikasi (Rules.md §3)
  idempotency_key         String?      @unique @db.VarChar(100)
  reporter_id             String       @db.Uuid
  category_id             String       @db.Uuid
  assigned_agency_id      String?      @db.Uuid
  assigned_officer_id     String?      @db.Uuid
  /// Auto-generated oleh AI, dapat diedit warga — max 500 karakter (Rules.md §2.1)
  description             String?      @db.Text
  latitude                Decimal      @db.Decimal(10, 8)
  longitude               Decimal      @db.Decimal(11, 8)
  /// Hasil reverse geocoding (Maps Service)
  address_text            String?      @db.VarChar(500)
  status                  ReportStatus @default(pending_verification)
  /// Hasil klasifikasi AI — 0.0–1.0 (Rules.md §1.2)
  ai_confidence_score     Float?
  /// Hasil Smart Priority Engine (Rules.md §1.3)
  urgency_score           Float?
  /// Denormalized counter (ERD.md §5) — update WAJIB dilakukan di service layer
  /// dalam database transaction bersamaan dengan insert/delete report_supports (bukan DB trigger),
  /// sesuai aturan Rules.md §4.1 & ERD.md §5.
  support_count           Int          @default(0)
  /// Denormalized counter (ERD.md §5) — diupdate di service layer saat laporan dibuka/dilihat
  view_count              Int          @default(0)
  estimated_completion_at DateTime?
  created_at              DateTime     @default(now())
  updated_at              DateTime     @updatedAt

  // Relations
  reporter         User                    @relation("ReporterReports", fields: [reporter_id], references: [id])
  category         Category                @relation(fields: [category_id], references: [id])
  assigned_agency  Agency?                 @relation("AssignedAgencyReports", fields: [assigned_agency_id], references: [id])
  assigned_officer User?                   @relation("AssignedOfficerReports", fields: [assigned_officer_id], references: [id])
  media            ReportMedia[]
  status_history   ReportStatusHistory[]
  supports         ReportSupport[]
  comments         ReportComment[]
  validations      CitizenValidation[]
  points_refs      ContributionPointsLog[]
  notifications    Notification[]

  // Standard B-tree indexes sesuai ERD.md §4
  // CATATAN: Spatial GIST index (PostGIS) untuk query peta/bbox ditambahkan via raw SQL migration
  // (src/prisma/migrations/*) karena Prisma tidak mendukung native GIST spatial index syntax.
  @@index([status])
  @@index([category_id])
  @@map("reports")
}

/// Media (foto) yang dilampirkan ke laporan (ERD §2.5)
model ReportMedia {
  id          String    @id @default(uuid()) @db.Uuid
  report_id   String    @db.Uuid
  type        MediaType
  url         String    @db.VarChar(500)
  uploaded_by String    @db.Uuid
  created_at  DateTime  @default(now())

  // Relations
  report   Report @relation(fields: [report_id], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploaded_by], references: [id])

  @@map("report_media")
}

/// Histori perubahan status laporan — audit trail wajib (Rules.md §3, PRD §7) (ERD §2.6)
/// WAJIB diisi setiap kali terjadi transisi status di service layer
model ReportStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  report_id   String       @db.Uuid
  status      ReportStatus
  note        String?      @db.Text
  /// Null jika perubahan dilakukan otomatis oleh sistem/AI
  changed_by  String?      @db.Uuid
  created_at  DateTime     @default(now())

  // Relations
  report  Report @relation(fields: [report_id], references: [id], onDelete: Cascade)
  changer User?  @relation(fields: [changed_by], references: [id])

  // Index untuk render timeline cepat (ERD §4)
  @@index([report_id, created_at])
  @@map("report_status_history")
}

/// Dukungan / upvote warga terhadap laporan (ERD §2.7)
model ReportSupport {
  id         String   @id @default(uuid()) @db.Uuid
  report_id  String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now())

  // Relations
  report Report @relation(fields: [report_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id])

  /// Unique constraint: 1 user hanya bisa mendukung 1x per laporan (Rules.md §1.4)
  @@unique([report_id, user_id])
  @@map("report_supports")
}

/// Komentar warga/operator pada laporan (ERD §2.8)
model ReportComment {
  id         String   @id @default(uuid()) @db.Uuid
  report_id  String   @db.Uuid
  user_id    String   @db.Uuid
  /// Max 300 karakter, wajib filter profanity di service layer (Rules.md §2.3)
  content    String   @db.Text
  created_at DateTime @default(now())

  // Relations
  report Report @relation(fields: [report_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id])

  @@map("report_comments")
}

/// Validasi warga bahwa laporan telah diselesaikan (ERD §2.9)
/// Hanya pelapor asli atau warga dalam radius CITIZEN_VALIDATION_RADIUS_M (Rules.md §1.5)
model CitizenValidation {
  id         String   @id @default(uuid()) @db.Uuid
  report_id  String   @db.Uuid
  user_id    String   @db.Uuid
  /// true = resolved, false = disputed (kembali ke in_progress)
  is_valid   Boolean
  note       String?  @db.Text
  created_at DateTime @default(now())

  // Relations
  report Report @relation(fields: [report_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id])

  @@map("citizen_validations")
}

/// Log poin kontribusi gamifikasi warga (ERD §2.10)
model ContributionPointsLog {
  id                  String             @id @default(uuid()) @db.Uuid
  user_id             String             @db.Uuid
  /// Bisa negatif untuk penalti spam (Rules.md §1.6)
  points              Int
  reason              ContributionReason
  reference_report_id String?            @db.Uuid
  created_at          DateTime           @default(now())

  // Relations
  user             User    @relation(fields: [user_id], references: [id])
  reference_report Report? @relation(fields: [reference_report_id], references: [id])

  @@map("contribution_points_log")
}

/// Zona Urban Emotion Map (ERD §2.11)
/// CATATAN: geo_boundary bertipe PostGIS geometry — perlu extension:
///   CREATE EXTENSION IF NOT EXISTS postgis;
/// Migrasi untuk kolom ini dilakukan via raw SQL karena Prisma tidak native PostGIS.
model Zone {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(100)
  /// PostGIS geometry(Polygon, 4326) — dikelola via raw SQL migration terpisah
  geo_boundary Unsupported("geometry")?
  stress_level StressLevel @default(low)
  updated_at   DateTime    @updatedAt

  // Relations
  metrics     ZoneMetric[]
  simulations PolicySimulation[]

  @@map("zones")
}

/// Histori metrik zona untuk model prediksi XGBoost (ERD §2.12)
model ZoneMetric {
  id                     String   @id @default(uuid()) @db.Uuid
  zone_id                String   @db.Uuid
  report_density         Int      @default(0)
  /// Data cuaca dari BMKG API — disimpan sebagai JSONB
  weather_context        Json?
  traffic_density        Float?
  flood_risk_probability Float?
  recorded_at            DateTime @default(now())

  // Relations
  zone Zone @relation(fields: [zone_id], references: [id], onDelete: Cascade)

  @@map("zone_metrics")
}

/// Simulasi kebijakan via Gemini LLM (ERD §2.13)
model PolicySimulation {
  id               String   @id @default(uuid()) @db.Uuid
  requested_by     String   @db.Uuid
  prompt_text      String   @db.Text
  zone_id          String?  @db.Uuid
  /// Narasi hasil Gemini
  result_narrative String?  @db.Text
  /// Proyeksi angka/grafik — disimpan sebagai JSONB
  result_data      Json?
  created_at       DateTime @default(now())

  // Relations
  requester User  @relation(fields: [requested_by], references: [id])
  zone      Zone? @relation(fields: [zone_id], references: [id])

  @@map("policy_simulations")
}

/// Subscription push notification untuk Route Alert (ERD §2.14)
model RouteAlertSubscription {
  id           String   @id @default(uuid()) @db.Uuid
  user_id      String   @unique @db.Uuid
  /// FCM device token
  device_token String   @db.VarChar(500)
  last_lat     Decimal? @db.Decimal(10, 8)
  last_long    Decimal? @db.Decimal(11, 8)
  updated_at   DateTime @updatedAt

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("route_alert_subscriptions")
}

/// Notifikasi in-app untuk user (ERD §2.15)
model Notification {
  id                  String           @id @default(uuid()) @db.Uuid
  user_id             String           @db.Uuid
  type                NotificationType
  title               String           @db.VarChar(255)
  body                String           @db.Text
  reference_report_id String?          @db.Uuid
  is_read             Boolean          @default(false)
  created_at          DateTime         @default(now())

  // Relations
  user             User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reference_report Report? @relation(fields: [reference_report_id], references: [id])

  // Index untuk query notifikasi belum dibaca (ERD §4)
  @@index([user_id, is_read])
  @@map("notifications")
}
