# ============================================================
# LaporKita Backend — Environment Variables Template
# Copy file ini menjadi .env dan isi nilai yang sesuai.
# JANGAN commit file .env ke repository.
# ============================================================

# ─── Application ────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database (PostgreSQL via Supabase / local Docker) ──────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://laporkita:laporkita_dev@localhost:5433/laporkita_db?schema=public"

# ─── Initial Admin Seed ─────────────────────────────────────
ADMIN_EMAIL=admin@laporkita.malangkota.go.id
ADMIN_PASSWORD=AdminLaporKita2026!
ADMIN_NAME="Admin LaporKita Kota Malang"

# ─── JWT Authentication ─────────────────────────────────────
JWT_SECRET=ganti_dengan_secret_acak_min_32_karakter
JWT_REFRESH_SECRET=ganti_dengan_refresh_secret_acak_min_32_karakter
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (BullMQ job queue) ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI Service (Python FastAPI — YOLOv11 + XGBoost) ────────
# Endpoint internal service AI terpisah (lihat Architecture.md §3.2)
AI_SERVICE_URL=http://localhost:8000

# ─── OpenStreetMap / Nominatim (Reverse Geocoding) ──────────
# Proyek ini memakai Nominatim OSM, BUKAN Google Maps Platform (berbayar).
# WAJIB diisi: User-Agent dengan identitas aplikasi sesuai usage policy
# Nominatim — request tanpa User-Agent yang jelas bisa diblokir.
# Public server: https://nominatim.openstreetmap.org (max 1 req/detik)
# Self-hosted: ganti URL ke instance sendiri (tanpa rate-limit 1 req/s)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=LaporKita/1.0 (laporkita@malangkota.go.id)

# ─── Google Gemini API (Policy Simulator) ───────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── File Storage (Supabase Storage / S3-compatible) ─────────
STORAGE_URL=https://your-project.supabase.co/storage/v1
STORAGE_BUCKET=laporkita-reports
STORAGE_KEY=your_supabase_service_role_key

# ─── Bounding Box Kota Malang (validasi GPS laporan) ─────────
# Format: latitude/longitude min-max wilayah pilot
MALANG_LAT_MIN=-8.2500
MALANG_LAT_MAX=-7.8500
MALANG_LNG_MIN=112.5000
MALANG_LNG_MAX=112.8000

# ─── Smart Priority Engine (bobot, dapat di-tuning tanpa redeploy) ──
# Lihat Rules.md §1.3
PRIORITY_W1_DAMAGE=0.40
PRIORITY_W2_SUPPORT=0.25
PRIORITY_W3_DENSITY=0.20
PRIORITY_W4_CATEGORY=0.15
PRIORITY_NEARBY_RADIUS_M=200

# ─── Citizen Validation ─────────────────────────────────────
# Lihat Rules.md §1.5
CITIZEN_VALIDATION_RADIUS_M=100
CITIZEN_VALIDATION_AUTO_RESOLVE_DAYS=7

# ─── Support Grace Period ────────────────────────────────────
# Lihat Rules.md §1.4 (grace period 5 menit untuk cancel dukungan)
SUPPORT_GRACE_PERIOD_MINUTES=5

# ─── SMS Gateway & OTP Phone Verification ───────────────────
# Provider SMS: mock | fonnte | zenziva | twilio
# CATATAN: SMS asli selalu berbayar. Gunakan 'mock' untuk dev & automated testing.
#
# ── Setup Fonnte (recommended) ────────────────────────────────────────────────
# 1. Daftar/login: https://app.fonnte.com
# 2. Buka menu "Devices" → "+ Tambah Device" → Scan QR dari WhatsApp
# 3. Salin Token dari detail device
# 4. Set SMS_PROVIDER=fonnte dan isi SMS_PROVIDER_API_KEY dengan token tersebut
# 5. FONNTE_TYPE: "whatsapp" (kirim via WA, device harus online)
#                 "sms" (SMS biasa, perlu paket SMS di akun Fonnte)
# ──────────────────────────────────────────────────────────────────────────────
SMS_PROVIDER=mock
SMS_PROVIDER_API_KEY=your_fonnte_token_here
SMS_PROVIDER_BASE_URL=https://api.fonnte.com/send
FONNTE_TYPE=whatsapp
FONNTE_COUNTRY_CODE=62

# ── Zenziva (alternatif SMS) ──────────────────────────────────────────────────
# Aktifkan dengan: SMS_PROVIDER=zenziva
# ZENZIVA_USER_KEY=your_zenziva_userkey
# ZENZIVA_PASS_KEY=your_zenziva_passkey

# OTP settings
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5

